<div class="edu-item">
  <div class="edu-header">
    <span class="edu-title">
      <span class="lang-en"><%= item.title.en %></span>
      <span class="lang-cn"><%= item.title.cn %></span>
    </span>
    <span class="edu-date"><%= item.date %></span>
  </div>
  <div class="edu-sub">
    <span class="lang-en"><%= item.subtitle.en %></span>
    <span class="lang-cn"><%= item.subtitle.cn %></span>
  </div>
  <% if (item.bullets.en.length || item.bullets.cn.length) { %>
  <ul class="exp-desc" style="margin-top:0.15rem;">
    <% item.bullets.en.forEach(function (b) { %>
      <li class="lang-en"><%= b %></li>
    <% }); %>
    <% item.bullets.cn.forEach(function (b) { %>
      <li class="lang-cn"><%= b %></li>
    <% }); %>
  </ul>
  <% } %>
</div>