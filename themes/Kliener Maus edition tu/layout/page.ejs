<!DOCTYPE html>
<html>
<%- partial('_partial/head') %>
<body>
  <div id="container">
    <div id="wrap">
      <%- partial('_partial/header', null, {cache: !config.relative_link}) %>
      <div class="outer">
        <section id="main"><%- partial('_partial/article', {post: page, index: false}) %></section>
        <% if (theme.sidebar && theme.sidebar !== 'bottom'){ %>
          <%- partial('_partial/sidebar', null, {cache: !config.relative_link}) %>
        <% } %>
      </div>
      <%- partial('_partial/footer', null, {cache: !config.relative_link}) %>
    </div>
    <%- partial('_partial/mobile-nav', null, {cache: !config.relative_link}) %>

      <!-- 云层遮罩：载入和转场共用 -->
  <div class="cloud-overlay is-active" id="cloudOverlay" aria-hidden="true">
    <div class="cloud-overlay__hint">
      <!-- 载入模式 -->
      <div class="cloud-overlay__hint--loading">
        <div class="cloud-overlay__spinner"></div>
        <div>加载中…</div>
      </div>
      <!-- 转场模式 -->
      <div class="cloud-overlay__hint--navigating">正在前往…</div>
    </div>
  </div>
  </div>
      <%- partial('_partial/after-footer') %>
</body>
</html>