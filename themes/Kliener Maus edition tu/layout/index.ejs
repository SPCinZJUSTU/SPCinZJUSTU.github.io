<!DOCTYPE html>
<html>
<title>鼠之勇者</title>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%- css('css/style') %>
  <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Raleway">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href='https://fonts.googleapis.com/css?family=Arvo' rel='stylesheet' type='text/css'>
  <link href="https://fonts.googleapis.com/css?family=Lato" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.css">




  <style>
    @import url("https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css");

    @font-face {
      font-family: 'Qiuyeyuan';
      /* 注意：要用 jsDelivr 的链接，不要用 github.com 的链接 */
      src: url('https://cdn.jsdelivr.net/gh/SPCinZJUSTU/SPCinZJUSTU.github.io/fonts/Qiuyeyuan-16.ttf') format('woff2');
      font-weight: 100;
      font-style: normal;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      font-display: swap;
      /* 让文字先显示，字体加载完再替换，避免白屏 */
    }





    h1,
    .white {
      color: #131212;
    }

    hr {
      height: 2px;
      background-color: #140304;
      border: none;
    }

    body,
    html {
      margin: 0;
      font-family: Lato, sans-serif;
      background: #d0d1d3;
      color: #222222;
    }

    .center-text {
      margin: auto;
      width: 550px;
      padding-top: 30px;
      padding-bottom: 50px;
      text-align: left;
    }

    @media screen and (max-width: 650px) {
      .center-text {
        width: 300px;
      }
    }

    .paragraph {
      padding: 10px;
      line-height: 2;
      letter-spacing: 0.03em;
      font-size: 16px;
    }

    .paragraph a {
      color: #000000;
      text-decoration: none;
    }

    .paragraph a:hover {
      color: rgb(0, 0, 0);
    }

    /* name, location, and social */
    .section-1 {
      padding-top: 40px;
      padding-bottom: 10px;
      text-align: left;
    }

    .section-1 p {
      font-size: 1.1rem;
      padding-bottom: 10px;
      text-indent: 10px;
      margin: 0;
    }

    .section-1 h1 {
      font-size: 3rem;
      text-indent: 10px;
      margin-bottom: 13px;
      font-family: Arvo, "Segoe UI", Arial, sans-serif;
      letter-spacing: 0.05em;
    }

    .section-1 a {
      font-size: 1.8rem;
      padding: 10px;
      color: #000000;
    }

    .section-1 a:hover {
      color: white;
      text-shadow: 0px 0px 25px white, 0px 0px 15px green, 0px 0px 10px blue;
    }

    /* Navigation bar */
    .navbar {
      overflow: hidden;
      padding-bottom: 150px;
      padding-top: 10px;
    }

    .navbar a {
      float: left;
      font-size: 16px;
      color: #9b9ea5;
      text-align: center;
      padding: 20px 10px;
      text-decoration: none;
    }

    /* dropdown menu */
    /* credit to https://codepen.io/jstn/pen/zuDst for the dynamic underline */
    .dropdown {
      float: left;
      overflow: hidden;
    }

    .dropdown .dropbtn {
      font-size: 16px;
      border: none;
      outline: none;
      color: #575252;
      padding: 20px 10px;
      background-color: rgb(156 176 217);
      font-family: inherit;
      margin: 0;
      text-transform: uppercase;
      text-decoration: none;
      letter-spacing: 0.15em;
      position: relative;
    }

    .dropdown .dropbtn:after {
      background: none repeat scroll 0 0 transparent;
      bottom: 0;
      content: "";
      display: block;
      height: 1px;
      left: 50%;
      position: absolute;
      background: #fff;
      transition: width 0.3s ease 0s, left 0.3s ease 0s;
      width: 0;
    }

    .dropdown .dropbtn:hover {
      color: white;
      background-color: rgb(36 75 157);
    }

    .dropdown .dropbtn:hover:after {
      width: 100%;
      left: 0;
      color: white;
    }

    .dropdown-content {
      display: none;
      position: absolute;
      text-align: left;
      padding-left: 10px;
      text-transform: none;
      text-decoration: none;
      letter-spacing: 0;
    }

    .dropdown-content a {
      float: none;
      color: #9b9ea5;
      padding: 20px 10px 0px 0px;
      text-decoration: none;
      display: block;
      text-align: left;
      text-shadow: none;
    }

    .dropdown-content a:hover {
      color: rgb(27, 27, 27);
    }

    .dropdown:hover .dropdown-content {
      display: block;
    }

    /* sidebar navigation */
    .sidenav {
      height: 100%;
      width: 0;
      position: fixed;
      z-index: 1;
      top: 0;
      left: 0;
      background-color: #111;
      overflow-x: hidden;
      transition: 0.2s;
      padding-top: 60px;
    }

    .sidenav a {
      padding: 8px 8px 8px 32px;
      text-decoration: none;
      font-size: 15px;
      color: #818181;
      display: block;
      transition: 0.2s;
    }

    .sidenav a:hover {
      color: #f1f1f1;
    }

    .sidenav .closebtn {
      position: absolute;
      top: 0;
      right: 25px;
      font-size: 36px;
      margin-left: 50px;
    }

    /* 遮罩容器：固定覆盖视口，不挡交互 */
    .cloud-mask {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      overflow: hidden;
    }

    /* 每朵云是一个 div，背景图指向素材库里的某张 SVG */
    .cloud {
      position: absolute;
      left: 0;
      top: 0;
      will-change: transform;
      transform-origin: center center;
      background-repeat: no-repeat;
      background-position: center;
      background-size: contain;
    }

    #navBuffer {
      position: fixed;
      top: 0;
      left: 250px;
      /* 贴在 nav 右边 */
      width: 60px;
      height: 100%;
      z-index: 9;
      pointer-events: auto;
      /* 让它能接收 mouseenter/leave */
      display: none;
      /* 默认隐藏，nav 打开时显示 */
    }

    /* ---------- 4. 极简文字链接 + 下划线动效 ---------- */
    .btn-text-underline {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: transparent;
      color: #0f172a;
      font-weight: 500;
      font-size: 2rem;
      font-family: cursive;
      padding: 0.5rem 0.2rem;
      top: 2rem;
      right: 2rem;
      border: none;
      cursor: pointer;
      text-decoration: none;
      position: absolute;
      transition: color 0.2s ease;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }

    .btn-text-underline::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: 0.25rem;
      width: 100%;
      height: 2px;
      background: #2563eb;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.25s cubic-bezier(0.2, 0.9, 0.4, 1);
      border-radius: 2px;
    }

    .btn-text-underline:hover {
      color: #2563eb;
    }

    .btn-text-underline:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .btn-text-underline .arrow {
      font-size: 1.1em;
      transition: transform 0.2s ease;
      display: inline-block;
    }

    .btn-text-underline:hover .arrow {
      transform: translateX(4px);
    }
  </style>


  <body class="is-loading">

    <div id="mySidenav" class="sidenav">
      <% for (var i in theme.menu){ %>
        <a href="<%- url_for(theme.menu[i]) %>">
          <%= i %>
        </a>
        <% } %>
    </div>
    <div id="navBuffer"></div>

    <div id='main'>
      <span style="position:fixed;padding:40px;font-size:30px;cursor:pointer" onclick="openNav()">&#9776;</span>
      <a href=<%- url_for('resume') %> class="btn-text-underline" ;" aria-label="简历（文字链接风格）">
        Resume
        <span class="arrow">↗</span>
      </a>
      <div class="center-text">
        <div class="section-1">
          <h1>PEICHENG SUN</h1>
          <p>Zhejiang, China</p>
          <div style="margin-top: 5px" , id="social-buttons">
            <a href=""><i class="fa fa-twitter fa-1x"></i></a>
            <a href="https://github.com/SPCinZJUSTU"><i class="fa fa-github fa-1x"></i></a>
            <a href="https://www.linkedin.com/in/aristoto-undefined-13243644b"><i class="fa fa-linkedin fa-1x"></i></a>
            <a href="aristoto238@gmail.com"><i class="fa fa-envelope fa-1x"></i></a>
          </div>
        </div>
        <hr>
        <div class="paragraph">
          <p>Hi, I'm Pei-Cheng Sun, a PhD researcher in cavity magnonics at Zhejiang University, working on microwave
            metamaterials and magnetic-semiconductor nonreciprocal devices.</p>
          <p>My work spans simulation, fabrication, and measurement: full-wave modeling of planar microwave devices
            and
            anisotropic materials in CST Studio Suite, turning layouts into hardware with a PCB engraver, and building
            VNA/oscilloscope setups to verify them. I'm particularly interested in the physical difference between
            ferrite gyromagnetic and magnetic-semiconductor gyroelectric models.</p>
          <p>I enjoy taking a problem all the way from equations and simulation curves to something that powers up,
            measures, and reproduces. If you're into microwave devices, metamaterials, or RF test automation, I'd be
            glad to connect.</p>
        </div>
        <hr>
        <div class="navbar">
          <div class="dropdown">
            <button id="drop-btn" , class="dropbtn">Whatsmore
              <i class="fa fa-caret-down"></i>
            </button>
            <div id="drop-content" , class="dropdown-content">
              <% for (var i in theme.menu){ %>
                <a href="<%- url_for(theme.menu[i]) %>">
                  <%= i %>
                </a>
                <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="cloud-mask" id="cloudMask" aria-hidden="true"></div>
    <!-- 云层遮罩：载入和转场共用 -->
    <div class="cloud-overlay is-active" id="cloudOverlay" aria-hidden="true">
      <div class="cloud-overlay__hint">
        <!-- 载入模式 -->
        <div class="cloud-overlay__hint--loading">
          <div class="cloud-overlay__spinner"></div>
          <div>加载中…</div>
        </div>
        <!-- 转场模式 -->
        <div class="cloud-overlay__hint--navigating">正在前往…</div>
      </div>
    </div>

    <%- partial('_partial/after-footer') %>
        <script>
          const mask = document.getElementById('cloudMask');

          // ===== 关闭定时器 =====
          let closeTimer = null;

          const sidenav = document.getElementById("mySidenav");

          /* ---------- 打开 ---------- */
          function openNav() {
            clearTimeout(closeTimer);          // 打开时取消任何待执行的关闭
            sidenav.style.width = "250px";
            document.getElementById("main").style.marginLeft = "250px";
          }

          /* ---------- 关闭 ---------- */
          function closeNav() {
            clearTimeout(closeTimer);
            sidenav.style.width = "0";
            document.getElementById("main").style.marginLeft = "0";
          }

          /* ---------- 方案 1 + 方案 2：鼠标离开后的延迟关闭 ---------- */

          // 鼠标进入（或通过缓冲区回来）→ 取消待关闭
          sidenav.addEventListener("mouseenter", () => {
            clearTimeout(closeTimer);
          });

          // 鼠标离开（含右侧 60px 透明缓冲区）→ 延迟 400ms 再关闭
          sidenav.addEventListener("mouseleave", () => {
            clearTimeout(closeTimer);
            closeTimer = setTimeout(closeNav, 400);
          });
        </script>

  </body>

</html>